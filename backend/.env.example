# Local MySQL example:
DATABASE_URL=mysql+pymysql://rental_app:replace-me@127.0.0.1:3306/smart_rental_sharing?charset=utf8mb4
# TiDB Cloud example:
# DATABASE_URL=mysql+pymysql://<user>.<prefix>:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/smart_rental_sharing?ssl_ca=/etc/ssl/certs/ca-certificates.crt

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_BYTES=12582912
RESET_TOKEN_MINUTES=15
RESET_TOKEN_DELIVERY=simulation
LATE_PENALTY_MULTIPLIER=1.0
